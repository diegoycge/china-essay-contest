msgstr "其他"

msgid ""
"This is an automated message from the judging portal. Please do not forward "
"it."
msgstr "这是评审系统自动发送的邮件，请勿转发。"

msgid "an administrator"
msgstr "管理员"

msgid "a judge"
msgstr "评委"

#, python-format
msgid "Invitation to the %(contest)s judging portal"
msgstr "%(contest)s评审系统邀请"

#, python-format
msgid ""
"Dear %(name)s,\n"
"\n"
"You have been invited to join the judging portal of the %(contest)s as %(role)s.\n"
"\n"
"Open this link to set up your sign-in. You can use a passkey (your fingerprint, face or device PIN) or choose a password:\n"
"%(link)s\n"
"\n"
"The link works once and expires in %(days)s days. Please do not forward it."
msgstr ""
"%(name)s，您好：\n"
"\n"
"诚邀您以%(role)s身份加入%(contest)s的评审系统。\n"
"\n"
"请打开以下链接设置登录方式。您可以使用通行密钥（指纹、面容或设备 PIN），也可以设置密码：\n"
"%(link)s\n"
"\n"
"该链接只能使用一次，%(days)s 天后失效。请勿转发。"

msgid "Set up your judging portal sign-in again"
msgstr "重新设置您的评审系统登录方式"

#, python-format
msgid ""
"Dear %(name)s,\n"
"\n"
"Use this link to create a new passkey or choose a new password:\n"
"%(link)s\n"
"\n"
"The link works once and expires in 24 hours. If you did not ask for it, you can ignore this message."
msgstr ""
"%(name)s，您好：\n"
"\n"
"请通过以下链接创建新的通行密钥或设置新密码：\n"
"%(link)s\n"
"\n"
"该链接只能使用一次，24 小时后失效。如果这不是您本人的操作，请忽略本邮件。"

#, python-format
msgid "%(count)s new essay to judge"
msgid_plural "%(count)s new essays to judge"
msgstr[0] "您有 %(count)s 篇新文章待评审"

#, python-format
msgid ""
"Dear %(name)s,\n"
"\n"
"%(count)s essay has been assigned to you for the %(contest)s."
msgid_plural ""
"Dear %(name)s,\n"
"\n"
"%(count)s essays have been assigned to you for the %(contest)s."
msgstr[0] ""
"%(name)s，您好：\n"
"\n"
"%(contest)s已向您分配了 %(count)s 篇文章。"

#, python-format
msgid "Please submit your scores by %(deadline)s."
msgstr "请在 %(deadline)s 之前提交评分。"

#, python-format
msgid ""
"Sign in to begin:\n"
"%(link)s"
msgstr ""
"登录后开始评审：\n"
"%(link)s"

#, python-format
msgid "Essay %(code)s referred to the committee chair"
msgstr "文章 %(code)s 已转交委员会主席处理"

#, python-format
msgid ""
"A judge has referred essay %(code)s (%(kind)s) in the %(contest)s.\n"
