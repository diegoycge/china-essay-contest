msgid "Sign-in link for %(email)s"
msgstr "%(email)s 的登录链接"

msgid ""
"It has been emailed. You can also send it yourself; the link is shown only "
"once."
msgstr "已通过邮件发送。您也可以自行发送；该链接仅显示这一次。"

msgid ""
"Nothing has been sent yet. Send this message from your own email: the button"
" opens it in your mail app, already addressed. The link works once and is "
"shown only now."
msgstr "尚未发送任何内容。请用您自己的邮箱发送这封邮件：点击按钮即可在您的邮件应用中打开，收件人已填好。该链接只能使用一次，且仅在此刻显示。"

msgid "Open in my email app"
msgstr "在我的邮件应用中打开"

msgid "Copy message"
msgstr "复制邮件内容"

msgid "Copy link only"
msgstr "仅复制链接"

msgid "Previous"
msgstr "上一页"

