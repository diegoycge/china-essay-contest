"No eligible judge is available for %(code)s. Every judge who has signed the "
"statement has either read it already, declared a conflict with its prompt, "
"or reached their limit."
msgstr "没有可分配给 %(code)s 的合格评委。所有已签署声明的评委要么已读过该文章，要么对其题目申明了冲突，要么已达到上限。"

#, python-format
msgid "%(code)s assigned to %(judge)s."
msgstr "%(code)s 已分配给 %(judge)s。"

msgid "Essay withdrawn. Judges can no longer see it."
msgstr "文章已撤回，评委无法再看到。"

msgid "Essay disqualified. Judges can no longer see it."
msgstr "文章已取消资格，评委无法再看到。"

msgid "Essay restored."
msgstr "文章已恢复。"

msgid "No essays are waiting for anonymization review."
msgstr "没有等待匿名化审核的文章。"

msgid "This essay has not been released yet."
msgstr "这篇文章尚未发放。"

msgid "The file was processed."
msgstr "文件已处理完成。"

msgid "Essay pulled back. Judges cannot see it until it is released again."
msgstr "文章已收回。再次发放之前评委无法看到。"

msgid "Automatic redaction re-run. Your own boxes were removed."
msgstr "已重新运行自动遮盖，您自己添加的方框已被移除。"

#, python-format
msgid "“%(term)s” redacted in %(n)s place."
msgid_plural "“%(term)s” redacted in %(n)s places."
msgstr[0] "“%(term)s”已在 %(n)s 处遮盖。"

#, python-format
msgid "“%(term)s” does not appear on the pages."
msgstr "页面上没有出现“%(term)s”。"

#, python-format
msgid "Not released: %(why)s."
msgstr "未发放：%(why)s。"

#, python-format
msgid "Not saved: %(why)s."
msgstr "未保存：%(why)s。"

#, python-format
msgid "%(code)s released for judging."
msgstr "%(code)s 已发放供评审。"

msgid "Saved. Judges now see the updated pages."
msgstr "已保存。评委现在看到的是更新后的页面。"

msgid "Saved."
msgstr "已保存。"

#, python-format
msgid "%(name)s has been invited."
msgstr "已邀请 %(name)s。"

msgid "Passkeys removed. Create a sign-in link so they can set up a new one."
msgstr "通行密钥已移除。请创建登录链接，以便对方重新设置。"

msgid "You cannot deactivate your own account."
msgstr "您不能停用自己的账号。"

msgid "Account reactivated."
msgstr "账号已重新启用。"

msgid "Account deactivated. Their unfinished essays should be reassigned."
msgstr "账号已停用。请重新分配其未完成的文章。"

msgid "The judge must sign the statement again before continuing."
msgstr "该评委必须重新签署声明后才能继续。"

#, python-format
msgid ""
"%(n)s unfinished assignments released. Run auto-assign to hand them to other"
" judges."
msgstr "已释放 %(n)s 项未完成的分配。请运行自动分配，将其交给其他评委。"

#, python-format
msgid "%(n)s assignment created."
msgid_plural "%(n)s assignments created."
msgstr[0] "已创建 %(n)s 项分配。"

#, python-format
msgid ""
"%(n)s essays still lack readers because no eligible judge was available: "
"%(codes)s"
msgstr "仍有 %(n)s 篇文章缺少评委，因为没有合格的评委可用：%(codes)s"

#, python-format
msgid "%(n)s judges notified by email."
msgstr "已通过邮件通知 %(n)s 位评委。"

msgid "Marked as announced."
msgstr "已标记为已通知。"

#, python-format
msgid "Reminder sent to %(n)s judges."
msgstr "已向 %(n)s 位评委发送提醒。"

msgid "Sheet reopened. The judge can edit and resubmit it."
msgstr "评分表已重新开放，评委可以修改并再次提交。"

msgid "This prompt has essays, so it was deactivated instead of deleted."
msgstr "该题目下已有文章，因此仅停用而未删除。"

msgid "Prompt deleted."
msgstr "题目已删除。"

msgid "Prompt saved."
msgstr "题目已保存。"

msgid "Settings saved."
msgstr "设置已保存。"
