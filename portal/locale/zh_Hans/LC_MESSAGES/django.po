msgid "Page %(n)s of %(total)s"
msgstr "第 %(n)s 页，共 %(total)s 页"

msgid "Next"
msgstr "下一页"

msgid "Waiting for your device…"
msgstr "正在等待您的设备…"

msgid "Cancelled, or your device did not respond. You can try again."
msgstr "已取消，或设备没有响应。您可以重试。"

msgid "This device already has a passkey for your account."
msgstr "此设备上已有您账号的通行密钥。"

msgid "That passkey is not registered with this portal."
msgstr "该通行密钥未在本系统登记。"

msgid "Too many failed attempts. Please wait a few minutes and try again."
msgstr "失败次数过多。请等待几分钟后再试。"

msgid "That did not work. Try again, or use a password instead."
msgstr "操作未成功。请重试，或改用密码。"

