msgstr "评审截止时间（%(deadline)s）已过，您还有 %(count)s 篇已分配的文章尚未提交。"

#, python-format
msgid "Reminder: %(count)s essay(s) to score by %(deadline)s"
msgstr "提醒：请在 %(deadline)s 前完成 %(count)s 篇文章的评分"

#, python-format
msgid ""
"You have %(count)s essay(s) still to score. The deadline is %(deadline)s."
msgstr "您还有 %(count)s 篇文章待评分，截止时间为 %(deadline)s。"

#, python-format
msgid "Dear %(name)s,"
msgstr "%(name)s，您好："

