# ---- Required ---------------------------------------------------------------
# Long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Database password, used only between containers. Letters and digits only
# (it is placed inside a URL, where # / ? @ : would break it). Generate with:
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Public address of the portal. SITE_ADDRESS is what Caddy serves and obtains a
# certificate for; SITE_URL is used for links in emails.
SITE_ADDRESS=judging.example.edu
SITE_URL=https://judging.example.edu
ALLOWED_HOSTS=judging.example.edu

# First administrator. On first start the portal creates this account and
# prints a one-time link in the logs (docker compose logs web) with which to
# set up your sign-in (a passkey or a password). Ignored once any
# administrator exists.
ADMIN_EMAIL=
ADMIN_NAME=

# ---- Email (optional) ---------------------------------------------------------
# Leave these empty to run without an email server: the portal then writes
# each invitation, new-essay notice and reminder for you, and a button opens
# it in your own mail app to send. Fill them in only if you want the portal to
# send by itself (including scheduled deadline reminders).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Essay Contest Judging <judging@example.edu>

# ---- Optional ---------------------------------------------------------------
# Time zone for deadlines and timestamps.
TIME_ZONE=America/New_York
# Largest PDF accepted, in MB (the web server refuses anything over 30), and
# the most pages an essay may have.
MAX_ESSAY_FILE_MB=25
MAX_ESSAY_PAGES=60
# On a server with 1 GB of memory, uncomment these two lines (and add swap;
# see the README): fewer web processes, and a lower memory cap for each PDF
# being processed.
# WEB_CONCURRENCY=2
# PDF_MEMORY_MB=768
# Set once HTTPS is confirmed working (seconds; 31536000 = one year).
HSTS_SECONDS=0
# Only for trying the stack over plain HTTP (SITE_ADDRESS=:80, no certificate).
# Browsers refuse to send sign-in cookies over HTTP unless this is 0.
# SECURE_COOKIES=0
